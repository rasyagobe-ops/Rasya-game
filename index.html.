
<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#070b12">
<title>RASYA.GG | Gaming Portfolio</title>

<style>
:root{
 --bg:#070b12;
 --panel:#111b29;
 --text:#f5f8ff;
 --muted:#aab9ca;
 --accent:#00ffe1;
 --border:#24404d;
}
body.light{
 --bg:#edf3fa;
 --panel:#ffffff;
 --text:#172438;
 --muted:#53657b;
 --accent:#008e91;
 --border:#cbd8e5;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{
 background:var(--bg);
 color:var(--text);
 font-family:Arial,sans-serif;
 transition:.3s;
 overflow-x:hidden;
}
body:before{
 content:"";
 position:fixed;
 inset:0;
 pointer-events:none;
 z-index:-1;
 background:
 radial-gradient(circle at 15% 15%,#00ffe122,transparent 30%),
 radial-gradient(circle at 85% 70%,#315cff20,transparent 35%);
}
header{
 position:sticky;top:0;z-index:10;
 padding:17px 7%;
 background:color-mix(in srgb,var(--bg) 90%,transparent);
 backdrop-filter:blur(15px);
 border-bottom:1px solid var(--border);
 display:flex;justify-content:space-between;
 align-items:center;gap:15px;flex-wrap:wrap;
}
.logo{
 font-size:24px;font-weight:900;
 color:var(--accent);letter-spacing:2px;
}
nav{display:flex;gap:16px;align-items:center;flex-wrap:wrap}
nav a{
 color:var(--text);text-decoration:none;
 font-size:13px;font-weight:bold;
}
nav a:hover{color:var(--accent)}
select,.theme{
 padding:10px;border-radius:7px;
 border:1px solid var(--accent);
 background:var(--panel);color:var(--text);
 font-weight:bold;
}
.theme{cursor:pointer}
.hero{
 min-height:570px;padding:100px 8%;
 display:flex;flex-direction:column;
 align-items:center;justify-content:center;
 text-align:center;position:relative;
}
.hero small{
 color:var(--accent);letter-spacing:5px;
 font-weight:bold;
}
.hero h1{
 font-size:clamp(45px,9vw,85px);
 margin:25px 0;
 text-shadow:0 0 30px #00ffe155;
}
.accent{color:var(--accent)}
.hero p{
 color:var(--muted);line-height:1.8;
 max-width:600px;
}
.btn{
 display:inline-block;margin-top:25px;
 padding:14px 25px;border-radius:7px;
 background:var(--accent);color:#061014;
 font-weight:bold;text-decoration:none;
}
.btn:hover{transform:scale(1.05)}
section{padding:75px 8%}
.heading{text-align:center;margin-bottom:35px}
.heading small{color:var(--accent);letter-spacing:4px}
.heading h2{font-size:32px;margin-top:12px}
.cards{
 display:grid;
 grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
 gap:20px;
}
.card{
 background:var(--panel);
 border:1px solid var(--border);
 border-radius:15px;padding:28px;
 transition:.3s;
 position:relative;overflow:hidden;
}
.card:hover{
 transform:translateY(-8px);
 border-color:var(--accent);
 box-shadow:0 0 25px #00ffe122;
}
.card .icon{font-size:38px}
.card h3{color:var(--accent);margin:17px 0 12px}
.card p{color:var(--muted);line-height:1.8;font-size:14px}
.rank{
 font-size:23px;color:var(--accent);
 font-weight:900;margin:12px 0;
}
.profile{
 max-width:750px;margin:auto;
 text-align:center;color:var(--muted);
 line-height:1.9;
}
.skills{
 display:flex;justify-content:center;
 flex-wrap:wrap;gap:12px;
}
.skills span{
 background:var(--panel);
 border:1px solid var(--border);
 padding:13px 18px;border-radius:8px;
 transition:.3s;
}
.skills span:hover{
 border-color:var(--accent);
 color:var(--accent);
 transform:translateY(-4px);
}
.contact{
 max-width:650px;margin:auto;
 text-align:center;background:var(--panel);
 border:1px solid var(--border);
 padding:35px;border-radius:15px;
}
.contact p{margin:15px 0;color:var(--muted)}
.contact a{color:var(--accent);text-decoration:none}
footer{
 padding:30px;text-align:center;
 color:var(--muted);border-top:1px solid var(--border);
}
@keyframes pulse{
 from{box-shadow:0 0 10px #00ffe122}
 to{box-shadow:0 0 30px #00ffe155}
}
.card{animation:pulse 3s infinite alternate}
@media(max-width:650px){
 header{justify-content:center}
 nav{justify-content:center}
 .hero{min-height:480px;padding:75px 7%}
 section{padding:55px 6%}
 .heading h2{font-size:27px}
}
</style>
</head>

