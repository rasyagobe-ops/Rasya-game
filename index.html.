<script>
const words={
 id:{
 nav1:"TENTANG",nav2:"GAME",nav3:"SKILL",nav4:"KONTAK",
 tagline:"Gamer • Teknologi • Pantang Menyerah",
 explore:"LIHAT PROFIL SAYA",
 about:"TENTANG SAYA",
 intro:"Halo! Nama saya Rasya. Saya menyukai dunia gaming, teknologi, strategi dan tantangan baru.",
 name:"Nama",birth:"Tanggal Lahir",hobby:"Hobi",
 achievement:"RANK TERTINGGI SAYA",
 highest:"Rank Tertinggi",
 skillsTitle:"KEAHLIAN SAYA",
 s1:"Strategi Gaming",s2:"Kerja Sama Tim",
 s3:"Komunikasi",s4:"Pengambilan Keputusan",
 s5:"Pemecahan Masalah",s6:"Cepat Belajar",
 contactTitle:"HUBUNGI SAYA"
 },
 en:{
 nav1:"ABOUT",nav2:"GAMES",nav3:"SKILLS",nav4:"CONTACT",
 tagline:"Gamer • Technology • Never Give Up",
 explore:"EXPLORE MY PROFILE",
 about:"ABOUT ME",
 intro:"Hello! My name is Rasya. I love gaming, technology, strategy and new challenges.",
 name:"Name",birth:"Date of Birth",hobby:"Hobby",
 achievement:"MY HIGHEST RANK",
 highest:"Highest Rank",
 skillsTitle:"MY SKILLS",
 s1:"Gaming Strategy",s2:"Teamwork",
 s3:"Communication",s4:"Quick Decision",
 s5:"Problem Solving",s6:"Fast Learning",
 contactTitle:"CONTACT ME"
 }
};

function setLanguage(lang){
 document.documentElement.lang=lang;
 document.querySelectorAll("[data-t]").forEach(el=>{
  const key=el.getAttribute("data-t");
  if(words[lang][key])el.textContent=words[lang][key];
 });
 localStorage.setItem("rasyaLang",lang);
 document.getElementById("language").value=lang;
}

function toggleTheme(){
 document.body.classList.toggle("light");
 const light=document.body.classList.contains("light");
 localStorage.setItem("rasyaTheme",light?"light":"dark");
 updateThemeButton();
}

function updateThemeButton(){
 const light=document.body.classList.contains("light");
 document.getElementById("themeBtn").textContent=
 light?"🌙 Dark":"☀️ Light";
}

const savedLang=localStorage.getItem("rasyaLang")||"id";
const savedTheme=localStorage.getItem("rasyaTheme")||"dark";

setLanguage(savedLang);
if(savedTheme==="light"){
 document.body.classList.add("light");
}
updateThemeButton();
</script>

